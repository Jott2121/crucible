{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest)",
      "Bash(python -m pytest:*)",
      "Bash(python -m build)",
      "Bash(python -m build:*)",
      "Bash(pip install:*)",
      "Bash(ruff check)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git tag -l)",
      "Bash(git tag -l:*)"
    ],
    "ask": [
      "Edit(/.github/workflows/publish.yml)",
      "Write(/.github/workflows/publish.yml)",
      "Edit(/action.yml)",
      "Write(/action.yml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/ruff-check.sh"
          }
        ]
      }
    ]
  }
}
